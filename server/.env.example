# Copia este archivo como .env y rellena los valores

# Conexión a MySQL
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/hourplay"

# Puerto del servidor backend
PORT=3000

# Clave de la API de RAWG (https://rawg.io/apidocs)
RAWG_API_KEY=

# Clave para firmar las cookies de sesión. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Inicio de sesión con Google, Apple, Facebook y GitHub (opcional) ---
# Solo se activan los proveedores que tengan sus claves rellenas.
# En cada consola registra como URL de retorno (callback):
#   {SERVER_URL}/api/auth/oauth/{google|apple|facebook|github}/callback
# URL pública del backend (en local: http://localhost:3000)
# SERVER_URL=http://localhost:3000

# https://console.cloud.google.com/apis/credentials (ID de cliente OAuth, aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://github.com/settings/developers (OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# https://developers.facebook.com/apps (producto "Inicio de sesión con Facebook")
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# https://developer.apple.com/account/resources (requiere cuenta de pago y HTTPS)
# APPLE_CLIENT_ID es el identificador del Services ID; la clave privada es el
# contenido del archivo .p8 en una sola línea, con los saltos escritos como \n
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Solo en producción ---
# NODE_ENV=production
# Dominios del frontend permitidos por CORS, separados por comas
# CLIENT_URL=https://tudominio.com,https://www.tudominio.com
# 'none' si frontend y backend están en dominios distintos
# COOKIE_SAMESITE=lax
