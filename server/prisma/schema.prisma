// schema.prisma - Definición de la estructura de la base de datos de HourPlay
// Este archivo define los modelos (tablas) y sus relaciones usando Prisma ORM.
// Prisma genera automáticamente las migraciones y el cliente para interactuar con la DB.

generator client {
  provider = "prisma-client-js"
  // He dejado la configuracion por defecto del generador para que Node.js 
  // encuentre el cliente automaticamente en la carpeta node_modules.
  // De esta forma evito errores de inicializacion durante el arranque del servidor.
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ MODELO: Usuario ============
// Representa a cada usuario registrado en HourPlay.
// La arquitectura híbrida de autenticación permite el acceso local 
// mediante credenciales encriptadas y facilita una futura 
// integración con proveedores OAuth. Se ha añadido la propiedad password
// como opcional para persistir el hash criptográfico generado en el backend.
model Usuario {
  id                 String   @id @default(uuid())
  email              String   @unique
  nombre             String?
  password           String?
  fotoUrl            String?
  proveedorAuth      String   
  proveedorId        String   
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  juegos             JuegoUsuario[]
  
  @@map("usuarios")
}

// ============ MODELO: Juego ============
// Si usamos APIs externas (RAWG + HowLongToBeat), este modelo NO se usa.
// Pero si el tutor NO permite APIs externas, aquí guardaríamos el catálogo de juegos.
// Por ahora lo dejamos comentado, lo activaremos solo si hace falta.

