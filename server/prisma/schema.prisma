// ============ MODELO: JuegoUsuario ============
// Tabla intermedia que relaciona usuarios con sus juegos.
// Aquí guardamos el estado personal de cada juego (pendiente, jugando, completado)
// y datos específicos del usuario (prioridad, progreso, notas).
model JuegoUsuario {
  id              String    @id @default(uuid())
  usuarioId       String
  
  juegoIdExterno  String
  titulo          String
  caratulaUrl     String?
  genero          String?
  plataforma      String?
  duracionPrincipal Int?
  duracionTotal   Int?
  
  estado          String    @default("pendiente")
  prioridad       String    @default("media")
  progreso        Int       @default(0)
  notasPersonales String?
  valoracion      Float?    // ← ESTA LÍNEA DEBE ESTAR
  
  fechaAgregado   DateTime  @default(now())
  fechaActualizacion DateTime @updatedAt
  
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  @@map("juegos_usuario")
  @@index([usuarioId])
}

// ============ MODELO: Sesion (opcional - para calendario) ============
// Representa sesiones de juego planificadas por el usuario en el calendario.
// Esta funcionalidad es secundaria, se implementa después del motor de recomendación.
model Sesion {
  id              String    @id @default(uuid())
  usuarioId       String
  juegoTitulo     String
  fechaInicio     DateTime
  fechaFin        DateTime
  completada      Boolean   @default(false)
  notas           String?
  fechaCreacion   DateTime  @default(now())
  
  @@map("sesiones")
  @@index([usuarioId])
}

// ============ MODELO: Session (sesiones de login) ============
// Almacén de las sesiones de inicio de sesión de express-session.
// No confundir con Sesion (partidas planificadas en el calendario).
// El nombre del modelo lo exige @quixo3/prisma-session-store (prisma.session).
model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.MediumText
  expiresAt DateTime

  @@map("sesiones_login")
}